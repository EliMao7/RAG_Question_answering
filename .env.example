# ============================================================================
# 环境变量模板 —— 复制为 .env 后填入你自己的值
#
#   cp .env.example .env        # Windows: copy .env.example .env
#
# .env 已被 .gitignore 排除，**不要提交**。
# config/config.ini 里只保留非敏感配置（host / port / 库名等），
# 密码与密钥一律通过本文件或部署环境的环境变量注入。
#
# 覆盖规则：EDU_{SECTION}_{OPTION}（全大写），例如 EDU_MYSQL_PASSWORD
# 覆盖 config.ini 的 [mysql].password。已存在的真实环境变量优先于本文件。
# ============================================================================

# ---------- MySQL ----------
EDU_MYSQL_HOST=localhost
EDU_MYSQL_PORT=3306
EDU_MYSQL_USER=edu_rag
# 请改成你自己的强密码（与 scripts/init_db.sql 中创建的账号一致）
EDU_MYSQL_PASSWORD=CHANGE_ME

# ---------- Redis ----------
EDU_REDIS_HOST=localhost
EDU_REDIS_PORT=6379
# 留空表示不鉴权；若 Redis 设了密码则填写
EDU_REDIS_PASSWORD=

# ---------- Milvus ----------
EDU_MILVUS_HOST=localhost
EDU_MILVUS_PORT=19530

# ---------- 通义千问（必需）----------
# 从阿里云百炼控制台获取：https://bailian.console.aliyun.com/
# 未设置时，问答链路会因调不了模型与向量化服务而失败
DASHSCOPE_API_KEY=

# ---------- 可选：检索参数覆盖 ----------
# EDU_RETRIEVAL_RETRIEVAL_K=10
# EDU_RETRIEVAL_CANDIDATE_M=3

# ---------- 可选：日志 ----------
# EDU_LOGGER_LOG_FILE=logs/app.log
# EDU_LOGGER_LOG_LEVEL=INFO
